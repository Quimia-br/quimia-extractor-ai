# Provedor de IA OpenAI-compatível (Command Code em produção)
LLM_API_KEY=user_fddfsdf
# gpt-6-luna com esforço low leu as FDS de teste em mediana de 10 s (xiaomi/mimo-v2.6-flash levava de 35 a 150 s)
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.commandcode.ai/provider/v1

# Tempo máximo de cada chamada à IA; deve caber no prazo total da extração (EXTRATOR_TIMEOUT_SECONDS)
LLM_TIMEOUT_SECONDS=22

# Novas tentativas em falhas temporárias
LLM_MAX_RETRIES=1

# Limite de tokens da resposta, incluindo raciocínio
LLM_MAX_OUTPUT_TOKENS=8000

# Esforço de raciocínio; só é enviado quando definido. O gpt-6-luna aceita low (minimal e none são recusados) e,
# sem ele, passa de 30 s por FDS
LLM_REASONING_EFFORT=low

# Token exigido em Authorization: Bearer <token> na rota POST /extracoes
EXTRATOR_API_TOKEN=gere_um_token_aleatorio

# Prazo total de uma extração; acima dele a rota responde 504 em JSON
EXTRATOR_TIMEOUT_SECONDS=25
